              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "mochi_items"
        ],
        "summary": "Delete Mochi Item",
        "description": "기록 soft delete — 행을 지우지 않고 ``deleted_at`` 마킹(되돌릴 수 있게, users 동일 패턴).\n\nowner-scoped. 없는/이미 삭제된/다른 owner 항목은 404(`mochi_item.not_found`). 이후 모든 조회\n(find/list/calendar/todos)가 ``deleted_at IS NULL`` 로 가려 목록·캘린더에서 사라진다.",
        "operationId": "delete_mochi_item_api_v1_mochi_items__mochi_item_id__delete",
        "parameters": [
          {
            "name": "mochi_item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Mochi Item Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "title": "Authorization",
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/v1/mochi_items/{mochi_item_id}/reanalyze": {
      "post": {
        "tags": [
          "mochi_items"
        ],
        "summary": "Reanalyze Mochi Item",
        "description": "needs_review 항목 재분석 — \"다른 의도\"에서 사용자가 적은 의도 힌트로 다시 분석한다.\n\n기존 outbox→``AgentOrchestrator`` 파이프라인을 그대로 재실행하되, 힌트를 분석 프롬프트에만\n합류시킨다(outbox 행에 일시 적재, ``mochi_items`` 미저장 — 사용자 메모 오염 방지).\n같은 item 을 재분석하므로 중복 캡처가 생기지 않는다.",
        "operationId": "reanalyze_mochi_item_api_v1_mochi_items__mochi_item_id__reanalyze_post",
        "parameters": [
          {
            "name": "mochi_item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Mochi Item Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "title": "Authorization",
              "type": "string",
              "nullable": true
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReanalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/mochi_items/{mochi_item_id}/instances/{instance_id}/lifecycle": {
      "post": {
        "tags": [
          "mochi_items"
        ],
        "summary": "Update Instance Lifecycle",
        "description": "intent instance 의 의미 lifecycle 전이 — 캘린더 todo 완료/완료취소.\n\n완료: ``lifecycleKind=archived`` + ``archiveReason=todoCompleted``.\n완료취소: ``lifecycleKind=active``(reason 생략). 합법성은 instance 의 intent_type 으로\n검증한다 — 불법 전이는 409(`intent_instance.illegal_transition`), 없는 instance 는 404.\ntodo 는 양방향(완료↔미완료)이 합법이라 잘못 누른 완료를 되돌릴 수 있다.",
        "operationId": "update_instance_lifecycle_api_v1_mochi_items__mochi_item_id__instances__instance_id__lifecycle_post",
        "parameters": [
          {
            "name": "mochi_item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Mochi Item Id"
            }
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Instance Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "title": "Authorization",
              "type": "string",
              "nullable": true
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstanceLifecycleUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MochiItemResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mochi_items/{mochi_item_id}/stream": {
      "get": {
        "tags": [
          "agent"
        ],
        "summary": "Stream Agent Run",
        "description": "SSE 스트림 — worker 의 실제 분석 진행(``mochi_items.lifecycle_kind``)을 관찰해 흘린다.\n\nforeground 클라가 폴링 대신 이 스트림을 구독한다. 백엔드는 처리상태 전이(``node``)와\n완료/실패 신호만 흘리고, **분석 결과 자체는 보내지 않는다** — 클라가 ``final`` 수신 시\n``GET /mochi_items/{id}`` 로 재조회한다(이중 직렬화 회피, PR-B 결정).\n\n실제 분석은 outbox 워커가 단일 소유한다(이중 실행 방지). 이 엔드포인트는 read-only 관찰자다.\nowner 가 아니면 404 (자원 존재 노출 방지).\n\n스트림 포맷:\n```\nevent: node\ndata: {\"mochi_item_id\":\"...\",\"lifecycle_kind\":\"analyzing\"}\n\nevent: final\ndata: {\"mochi_item_id\":\"...\",\"lifecycle_kind\":\"analyzed\"}\n```",
        "operationId": "stream_agent_run_api_v1_mochi_items__mochi_item_id__stream_get",
        "parameters": [
          {
            "name": "mochi_item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Mochi Item Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "title": "Authorization",
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },

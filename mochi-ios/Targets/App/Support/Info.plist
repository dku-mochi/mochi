<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>모찌</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Live Activity 활성화 (MochiLiveActivity).
	     `Activity<...>.request()` 가 거부되지 않으려면 필수. iOS 16.1+. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<!-- iOS 10+. 사설 IP(RFC 1918) / .local / unqualified host 에 대한 ATS 예외.
		     실기기를 같은 Wi-Fi의 macOS 백엔드에 붙일 때 192.168.x.x HTTP 호출을 허용한다.
		     운영 빌드는 HTTPS 도메인만 쓰므로 영향 없음. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- "Inject Dev LAN Host" post-build script(Project.swift) 가 Debug 빌드에서
	     `ipconfig getifaddr en0` 결과로 이 값을 갱신한다. Release 빌드에서는 비워둠. -->
	<key>MOCHI_DEV_HOST</key>
	<string></string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>일정 Intent로 분류된 기록을 캘린더에 등록·동기화하기 위해 사용합니다.</string>
	<key>NSCameraUsageDescription</key>
	<string>현장에서 자료를 즉시 캡처하기 위해 사용합니다.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>스크린샷에서 URL·제목 등 정보를 추출하기 위해 사용합니다.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>할일 Intent로 분류된 기록을 미리알림에 등록·동기화하기 위해 사용합니다.</string>
	<!-- Google OAuth (CFBundleURLTypes 의 reversed client ID URL scheme + GIDClientID) 는
	     실제 iOS OAuth client 값 확보 후 추가한다. 플레이스홀더를 박으면 App Store Connect
	     업로드 validation 이 "URL scheme not in correct format" 으로 실패하므로 비워 둔다.
	     현재 TestFlight 빌드는 Apple 로그인만 동작 (Google 버튼은 노출되나 client 미설정 시 실패).
	     복원 절차: docs/TODO.md §2.1(GIDClientID), §3.1(reversed client ID URL scheme). -->
	<!-- iOS 26 Liquid Glass 전역 opt-out — 탭바 등 시스템 UI 를 iOS 18 레거시 디자인으로 고정.
	     빌드 SDK 가 iOS 26.2 라 UITabBarAppearance 만으로는 탭바 리퀴드가 남아 전역 비활성화.
	     Apple 이 향후 deprecate 예정인 임시 호환 플래그. -->
	<key>UIDesignRequiresCompatibility</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>

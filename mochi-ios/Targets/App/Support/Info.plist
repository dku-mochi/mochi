<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Live Activity 활성화 (MochiLiveActivity).
	     `Activity<...>.request()` 가 거부되지 않으려면 필수. iOS 16.1+. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- silent 동기화 push (content-available) — 분석 완료된 확정 schedule/todo 를 앱을 열지 않아도
	     시스템 캘린더·미리알림에 반영(SystemCalendarSyncEngine). UX_SPEC §1.5 자동 관리. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<!-- iOS 10+. 사설 IP(RFC 1918) / .local / unqualified host 에 대한 ATS 예외.
		     실기기를 같은 Wi-Fi의 macOS 백엔드에 붙일 때 192.168.x.x HTTP 호출을 허용한다.
		     운영 빌드는 HTTPS 도메인만 쓰므로 영향 없음. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- "Inject Dev LAN Host" post-build script(Project.swift) 가 Debug 빌드에서
	     `ipconfig getifaddr en0` 결과로 이 값을 갱신한다. Release 빌드에서는 비워둠. -->
	<key>MOCHI_DEV_HOST</key>
	<string></string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>일정 Intent로 분류된 기록을 캘린더에 등록·동기화하기 위해 사용합니다.</string>
	<key>NSCameraUsageDescription</key>
	<string>현장에서 자료를 즉시 캡처하기 위해 사용합니다.</string>
	<!-- 앱은 위치 권한을 요청하지 않음 — NMapsMap(바이너리 SDK)의 CoreLocation 참조로
	     ITMS-90683 정적 검사를 통과시키기 위한 문구 (2026-07-15). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>장소로 저장된 기록을 지도에 표시하기 위해 사용합니다.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>스크린샷에서 URL·제목 등 정보를 추출하기 위해 사용합니다.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>기록에 저장된 이미지를 사진 앱에 저장하기 위해 사용합니다.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>할일 Intent로 분류된 기록을 미리알림에 등록·동기화하기 위해 사용합니다.</string>
	<!-- Google OAuth 결선 (2026-06-23) — iOS OAuth client(app.mochi) 값 주입 완료.
	     GIDClientID = CLIENT_ID, CFBundleURLTypes = REVERSED_CLIENT_ID URL scheme.
	     출처: GCP iOS OAuth client "OAuth 클라이언트 ID.plist". GoogleSignIn 8.x 는 config 미지정 시
	     이 GIDClientID 를 자동 로드하고, OAuth redirect 는 아래 URL scheme 으로 돌아온다
	     (MochiApp.onOpenURL → LiveGoogleAuthClient.handle(url:)). 절차: docs/TODO.md §2.1·§3.1. -->
	<key>GIDClientID</key>
	<string>342560597049-732omfb5ut3tgut5epcr4irj5tjfodgg.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>app.mochi.google-oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.342560597049-732omfb5ut3tgut5epcr4irj5tjfodgg</string>
			</array>
		</dict>
	</array>
	<!-- 네이버 지도 SDK 인증 키 (NCP 콘솔 > Maps > Application 의 Client ID, 번들ID app.mochi 등록 필수).
	     비어 있으면 기록상세 장소 카드가 MapKit 프리뷰로 폴백한다(PlaceMapSection.hasNaverMapKey).
	     GIDClientID 처럼 비밀값이 아닌 앱 식별자 — 번들ID 바인딩으로 보호된다. 절차: docs/TODO.md. -->
	<key>NMFNcpKeyId</key>
	<string>tp1cgegjns</string>
	<!-- iOS 26 Liquid Glass 전역 opt-out — 탭바 등 시스템 UI 를 iOS 18 레거시 디자인으로 고정.
	     빌드 SDK 가 iOS 26.2 라 UITabBarAppearance 만으로는 탭바 리퀴드가 남아 전역 비활성화.
	     Apple 이 향후 deprecate 예정인 임시 호환 플래그. -->
	<key>UIDesignRequiresCompatibility</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>

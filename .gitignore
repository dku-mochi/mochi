# 모찌 루트 모노레포 통합 *예정* — 통합 시 사용할 .gitignore 시드.
# 현재(통합 전)는 mochi-ios, mochi-backend 가 각각 git. 이 파일은 통합 PR 의 초석.

# macOS
.DS_Store

# 일시 작업물
tmp/
_workspace/
*.log
*.tmp
.playwright-mcp/

# lab 실험 데이터 (개인 스크린샷 등 — git 추적 금지, 별도 공유)
lab/data/

# lab RAG 실험 파생 데이터 (개인 스크린샷 summary/entity/embedding 포함 — 개인정보 보호)
lab/active/rag-search/artifacts/
lab/active/rag-search/results/

# rag-rerank-eval 임베딩 캐시 (8.5MB, 합성 데이터 — run_eval.py 재실행으로 재생성 가능)
lab/active/rag-rerank-eval/artifacts/

# 환경/비밀 — 절대 커밋 금지 (.claude/settings.json deny 와 중첩 안전망)
.env
.env.*
*.pem
*.key

# 빌드 산출
build/
.build/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
.tuist-derived/

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# 인증/세션 등 운영 외부 자산
*.p8
*.mobileprovision

# AI 하네스 로컬 캐시 (codex 세션 id 등 — 머신 로컬, 공유 불필요)
.context/

# AI 서브에이전트 격리 worktree (도구가 생성, 머신 로컬 — 커밋 금지)
.claude/worktrees/

# 숏컷 작업 공간 (로컬 전용 — 단축어 후보 .shortcut·빌드 스크립트, 본인 관리)
shortcuts/

  "components": {
    "schemas": {
      "AppleSignInRequest": {
        "properties": {
          "identityToken": {
            "type": "string",
            "minLength": 10,
            "title": "Identitytoken"
          },
          "rawNonce": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rawnonce"
          },
          "fullName": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Fullname"
          },
          "deviceLabel": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Devicelabel"
          }
        },
        "type": "object",
        "required": [
          "identityToken"
        ],
        "title": "AppleSignInRequest"
      },
      "CaptureChannel": {
        "type": "string",
        "enum": [
          "kakaoTalk",
          "instagram",
          "youtube",
          "safari",
          "screenshot",
          "appIntent",
          "appShareSheet",
          "appDirectInput",
          "unknown"
        ],
        "title": "CaptureChannel"
      },
      "CaptureCreateRequest": {
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/CaptureChannel"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "userMemo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usermemo"
          },
          "imageRefs": {
            "items": {
              "$ref": "#/components/schemas/ImageRefDTO"
            },
            "type": "array",
            "title": "Imagerefs"
          }
        },
        "type": "object",
        "required": [
          "channel"
        ],
        "title": "CaptureCreateRequest",
        "description": "클라이언트(iOS)가 보내는 capture ingestion payload.\n\niOS는 본 스키마와 동일한 모양의 ``CaptureIngestRequest`` 를 송신한다 — 양쪽이 OpenAPI 로 검증된다."
      },
      "CaptureResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "channel": {
            "$ref": "#/components/schemas/CaptureChannel"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "userMemo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usermemo"
          },
          "intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Intent"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "importance": {
            "type": "integer",
            "title": "Importance"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "lifecycleKind": {
            "type": "string",
            "title": "Lifecyclekind"
          },
          "syncKind": {
            "type": "string",
            "title": "Synckind"
          },
          "imageRefs": {
            "items": {
              "$ref": "#/components/schemas/ImageRefResponse"
            },
            "type": "array",
            "title": "Imagerefs"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Capturedat"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "channel",
          "url",
          "text",
          "intent",
          "summary",
          "importance",
          "confidence",
          "lifecycleKind",
          "syncKind",
          "capturedAt",
          "createdAt"
        ],
        "title": "CaptureResponse"
      },
      "CitationDTO": {
        "properties": {
          "captureId": {
            "type": "string",
            "format": "uuid",
            "title": "Captureid"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "captureId",
          "snippet",
          "score"
        ],
        "title": "CitationDTO"
      },
      "DevSignInRequest": {
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-.]+$",
            "title": "Subject"
          },
          "displayName": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Displayname"
          },
          "deviceLabel": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Devicelabel"
          }
        },
        "type": "object",
        "required": [
          "subject"
        ],
        "title": "DevSignInRequest",
        "description": "Local-only 임시 로그인 요청. ``subject`` 가 user 식별자 역할."
      },
      "GoogleSignInRequest": {
        "properties": {
          "idToken": {
            "type": "string",
            "minLength": 10,
            "title": "Idtoken"
          },
          "deviceLabel": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Devicelabel"
          }
        },
        "type": "object",
        "required": [
          "idToken"
        ],
        "title": "GoogleSignInRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageRefDTO": {
        "properties": {
          "objectKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Objectkey"
          },
          "mimeType": {
            "type": "string",
            "title": "Mimetype"
          },
          "byteSize": {
            "type": "integer",
            "maximum": 52428800.0,
            "minimum": 0.0,
            "title": "Bytesize"
          },
          "sha256": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Sha256"
          }
        },
        "type": "object",
        "required": [
          "mimeType",
          "byteSize",
          "sha256"
        ],
        "title": "ImageRefDTO",
        "description": "클라이언트가 업로드한 이미지에 대한 참조.\n\n실제 바이트는 별도 객체 스토리지 업로드 후 ``object_key`` 로만 전달된다."
      },
      "ImageRefResponse": {
        "properties": {
          "objectKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Objectkey"
          },
          "mimeType": {
            "type": "string",
            "title": "Mimetype"
          },
          "byteSize": {
            "type": "integer",
            "title": "Bytesize"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          }
        },
        "type": "object",
        "required": [
          "mimeType",
          "byteSize",
          "sha256"
        ],
        "title": "ImageRefResponse",
        "description": "캡처 응답에 포함되는 이미지 참조."
      },
      "Intent": {
        "type": "string",
        "enum": [
          "schedule",
          "todo",
          "knowledge",
          "memo"
        ],
        "title": "Intent",
        "description": "모찌의 4-Intent 분류. iOS `CoreDomain.Intent` 와 완전히 동일한 문자열 값."
      },
      "LogoutRequest": {
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 10,
            "title": "Refreshtoken"
          }
        },
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "title": "LogoutRequest"
      },
      "RefreshRequest": {
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 10,
            "title": "Refreshtoken"
          },
          "deviceLabel": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Devicelabel"
          }
        },

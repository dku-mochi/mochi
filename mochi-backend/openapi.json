    "/api/v1/auth/dev": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign In Dev",
        "description": "로컬 개발용 임시 로그인. ``environment=local`` 에서만 응답한다.\n\niOS의 \"임시 로그인\" 버튼이 호출한다. Apple/Google JWKS 검증을 거치지 않고\nsubject 만으로 결정론적 user 를 만들고 자체 access/refresh JWT 를 발급한다.",
        "operationId": "sign_in_dev_api_v1_auth_dev_post",
        "parameters": [
          {
            "name": "User-Agent",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },

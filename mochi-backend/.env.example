# mochi-backend 환경 변수 — 복사해서 .env 로 사용
ENVIRONMENT=local
DEBUG=true

# Postgres + pgvector (docker-compose db 서비스와 동일 값)
DATABASE_URL=postgresql+asyncpg://mochi:mochi@localhost:5432/mochi

# Vertex AI / Gemini
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIM=768
# 로컬에서는 `gcloud auth application-default login` 으로 ADC 발급

# 캡처 이미지 스토리지 — GCS (백탭 스크린샷). 클라가 Signed URL 로 GCS 에 직접 업로드,
# Gemini 는 gs://{bucket}/{objectKey} 를 직접 read. 미설정 시 presign 비활성(503).
# signer SA 는 사용자 ADC 가 tokenCreator 로 impersonate (키 파일 불필요).
GCS_CAPTURE_BUCKET=
GCS_SIGNER_SERVICE_ACCOUNT=
GCS_SIGNED_URL_TTL_SECONDS=900

# Agent loop budgets
AGENT_MAX_STEPS=8
AGENT_STEP_TIMEOUT_SECONDS=30
AGENT_TOTAL_TIMEOUT_SECONDS=120

# WebFetch guards
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_TIMEOUT_SECONDS=8

# PlatformContext — Instagram 공식 oEmbed 사용 시만 설정. 비우면 OG fallback.
INSTAGRAM_OEMBED_ACCESS_TOKEN=
INSTAGRAM_OEMBED_API_VERSION=v20.0

# Hybrid search
BM25_K=80
VECTOR_K=80
RRF_K_CONSTANT=60
RERANKER_ENABLED=false
RERANKER_TOP_N=30

# === Auth — 자체 발행 access JWT ===
# 운영에서는 반드시 회전: `openssl rand -base64 48`
AUTH_ACCESS_SECRET=dev-insecure-please-rotate-in-prod-with-openssl-rand-base64-48
AUTH_ACCESS_TTL_SECONDS=1800
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_JWT_AUDIENCE=mochi.app
AUTH_JWT_ISSUER=mochi.app

# === Auth — Apple Sign In ===
AUTH_APPLE_AUDIENCE=app.mochi
AUTH_APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
AUTH_APPLE_ISSUER=https://appleid.apple.com

# === Auth — Google Sign In ===
# 콤마로 다중 client_id 허용. iOS client_id 는 필수.
AUTH_GOOGLE_CLIENT_IDS=
AUTH_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# 레거시(외부 IdP) JWKS — 비워두면 자체 발행 JWT 모드.
AUTH_JWKS_URL=
